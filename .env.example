# ——— Server ———
PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001

# Reverse proxy / HTTPS (auto-enabled when NODE_ENV=production)
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1
# FORCE_HTTPS=true

# Comma-separated list of allowed browser origins for API requests.
# Required in production. Example: https://godrive.example.com,https://www.godrive.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ——— API auth & PostgreSQL (login, /api/orders) ———
# JWT_SECRET: required for login and protected routes (minimum 32 characters, cryptographically random).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Supported roles: admin, driver, client (customer)
JWT_SECRET=
DB_USER=postgres
DB_HOST=localhost
DB_NAME=godrive
DB_PASSWORD=
DB_PORT=5432

# ——— Contact form (e-mail via Nodemailer) ———
CONTACT_MAIL_TO=recipient@example.com
CONTACT_MAIL_FROM_NAME=Go Drive — site

# Gmail example: create an App Password (Google Account → Security → 2-Step → App passwords)
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=youraccount@gmail.com
CONTACT_SMTP_PASS=your_app_password_here

# Without SMTP above: in development, contact form may use Ethereal (see server logs).
# In production without SMTP: set CONTACT_USE_ETHEREAL=true only for staging tests.
# CONTACT_USE_ETHEREAL=true

# Optional: max contact submissions per IP per hour (default 15)
# CONTACT_RATE_MAX_PER_HOUR=15

# ——— Dev-only: POST /api/support (Ethereal test mail) ———
# Disabled by default. Set ENABLE_SUPPORT_API=true only in local development.
# ENABLE_SUPPORT_API=true
