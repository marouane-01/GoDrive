# ——— Contact form (e-mail via Nodemailer) ———
# Inbox that receives contact form submissions (required when CONTACT_SMTP_* is set)
CONTACT_MAIL_TO=recipient@example.com
CONTACT_MAIL_FROM_NAME=Go Drive — site

# Gmail example: create an App Password (Google Account → Security → 2-Step → App passwords)
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=youraccount@gmail.com
CONTACT_SMTP_PASS=your_app_password_here

# Sans les variables ci-dessus : en développement (NODE_ENV != production), les envois passent
# par Ethereal (faux SMTP) — voir l’URL d’aperçu dans les logs du serveur.
# En production sans SMTP : définir CONTACT_USE_ETHEREAL=true pour le même comportement (tests),
# sinon le formulaire renvoie une erreur de configuration.
# CONTACT_USE_ETHEREAL=true

# Optional: max submissions per IP per hour (default 15)
# CONTACT_RATE_MAX_PER_HOUR=15

# ——— POST /api/support (Ethereal test mail) ———
# No env vars required: Nodemailer creates a disposable Ethereal account at runtime.
# JSON body: { "name", "email", "subject", "message" } — response includes previewUrl.

# ——— API auth & PostgreSQL (login, /api/orders) ———
# JWT_SECRET: required for login and protected routes (min. 8 characters).
# JWT_SECRET=change_me_to_a_long_random_string
# DB_USER=
# DB_HOST=localhost
# DB_NAME=godrive
# DB_PASSWORD=
# DB_PORT=5432
